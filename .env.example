# ── Option A: Meta API (requires billing card — preferred for submission) ────
# META_API_KEY=LA-xxxxxxxxxxxx
# META_API_BASE_URL=https://api.llama.com/v1
# MUSE_SPARK_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# MUSE_CODE_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# ── Option B: Together AI ($1 free credit, no card, Llama 4 Maverick) ─────────
# Sign up at api.together.xyz/signin → Continue with Google → copy key
META_API_KEY=your_together_api_key_here
META_API_BASE_URL=https://api.together.xyz/v1
MUSE_SPARK_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-Turbo
MUSE_CODE_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-Turbo

# ── Option C: Fireworks AI (approved hackathon provider, ~$1 free) ────────────
# META_API_KEY=fw_xxxxxxxxxxxx
# META_API_BASE_URL=https://api.fireworks.ai/inference/v1
# MUSE_SPARK_MODEL=accounts/fireworks/models/llama4-maverick-instruct-basic
# MUSE_CODE_MODEL=accounts/fireworks/models/llama4-maverick-instruct-basic

# Loom-Protocol signing secret — change before any public deploy
LOOM_SECRET=argus-dev-secret-change-in-prod
