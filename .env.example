# ── Option A: Local dev with Ollama (no API key needed) ───────────────────────
# META_API_KEY=ollama
# META_API_BASE_URL=http://localhost:11434/v1
# MUSE_SPARK_MODEL=mistral:latest
# MUSE_CODE_MODEL=mistral:latest

# ── Option B: Groq (free, Meta Llama 3.3 70B, ~10s audits) ───────────────────
# Sign up at console.groq.com → copy key (starts with gsk_)
# META_API_KEY=gsk_...
# META_API_BASE_URL=https://api.groq.com/openai/v1
# MUSE_SPARK_MODEL=llama-3.3-70b-versatile
# MUSE_CODE_MODEL=llama-3.3-70b-versatile

# ── Option C: Meta API (requires billing card — best for submission) ──────────
# META_API_KEY=LA-xxxxxxxxxxxx
# META_API_BASE_URL=https://api.llama.com/v1
# MUSE_SPARK_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# MUSE_CODE_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# Fill in the option you want to use:
META_API_KEY=your_api_key_here
META_API_BASE_URL=https://api.groq.com/openai/v1
MUSE_SPARK_MODEL=llama-3.3-70b-versatile
MUSE_CODE_MODEL=llama-3.3-70b-versatile

# Loom-Protocol signing secret — change before any public deploy
LOOM_SECRET=argus-dev-secret-change-in-prod

# Comma-separated extra CORS origins (set in Railway to your Vercel URL)
CORS_ORIGINS=
