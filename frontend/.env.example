# Frontend environment variables (copy to `.env` for local development)

# Canonical public origin. Used for canonical URLs, Open Graph tags, sitemap
# and robots.txt. Do not add a trailing slash.
VITE_SITE_URL=https://frontend-eight-theta-43.vercel.app

# Public support / privacy contact shown in the footer and legal pages.
VITE_CONTACT_EMAIL=necrospre@gmail.com

# Supabase project (auth only; audit data is read through the Argus API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
